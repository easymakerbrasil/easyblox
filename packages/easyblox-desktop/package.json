{
  "name": "@easymaker/easyblox-desktop",
  "version": "0.4.0-rc.1",
  "private": true,
  "description": "Windows desktop host and distribution infrastructure for EasyBlox.",
  "license": "AGPL-3.0-only",
  "main": "src/main.js",
  "scripts": {
    "build": "node --check src/main.js && node --check src/arduino-runtime.js && node --check src/gui-static-server.js && node --check src/serial-port-picker.js && node --check src/serial-port-picker-preload.js && node --check src/serial-port-picker-renderer.js && node --check src/update-service.js",
    "icons:build": "node scripts/build-icons.mjs",
    "runtime:stage": "node scripts/stage-arduino-runtime.mjs",
    "test": "node --test test/*.test.js",
    "start": "electron .",
    "rebuild:native": "electron-rebuild -f -w serialport"
  },
  "dependencies": {
    "@easymaker/easyblox-hardware-service": "0.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.5"
  },
  "build": {
    "appId": "br.com.easyblox.desktop",
    "productName": "EasyBlox",
    "directories": {
      "buildResources": "build"
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/splash.html",
        "to": "splash.html"
      },
      {
        "from": "runtime/staged/easyblox-arduino-runtime",
        "to": "easyblox-arduino-runtime"
      },
      {
        "from": "../scratch-gui/build",
        "to": "scratch-gui/build",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EasyBlox",
      "runAfterFinish": true
    }
  }
}
